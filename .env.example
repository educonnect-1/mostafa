# Copy this file to `.env` in the project root and fill in your real values.
# `.env` is gitignored and must never be committed.
#
# Only the public Supabase URL and anon/publishable key belong here.
# NEVER put a Supabase service-role key, Cloudflare R2 secret, or any other
# private credential in this file or anywhere in the Flutter app.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
